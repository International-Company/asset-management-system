# Copy to .env for local development. Never commit real secrets.

# development | test | staging | production
APP_ENV=development
NODE_ENV=development
PORT=3000
TZ=Asia/Hebron
# Comma-separated list of allowed web origins (CORS).
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

DATABASE_URL=postgresql://osooli:osooli_dev@localhost:5433/osooli
TEST_DATABASE_URL=postgresql://osooli:osooli_dev@localhost:5433/osooli_test

# Authentication provider: "mock" (development/test only) or "eap".
AUTH_PROVIDER=mock
# Password accepted by the mock provider for every seeded user.
MOCK_AUTH_PASSWORD=dev-password
# Fingerprint code accepted by the mock provider (simulates the EAP step).
MOCK_AUTH_FINGERPRINT=000000

EAP_API_URL=
EAP_CLIENT_ID=
EAP_CLIENT_SECRET=

# Object storage (S3-compatible). "local" stores files on disk (dev only).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=osooli
STORAGE_ACCESS_KEY=osooli
STORAGE_SECRET_KEY=osooli_dev_secret

# 32+ random bytes, base64. Used for signing session tokens.
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktY2hhbmdlLW1lLTEyMzQ1Ng==

# Chromium for Arabic PDF rendering. Leave empty locally (uses the Playwright
# browser: npx playwright install chromium). Docker sets /usr/bin/chromium-browser.
CHROMIUM_PATH=

# First System Administrator on a fresh staging/production database (the seed
# never runs there). Used only while no active System Administrator exists.
# INITIAL_ADMIN_EAP_EMPLOYEE_ID=
# INITIAL_ADMIN_USERNAME=
